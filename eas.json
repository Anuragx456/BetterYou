{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_PROXY_URL": "https://betteryou-proxy.fly.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_PROXY_URL": "https://betteryou-proxy.fly.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
