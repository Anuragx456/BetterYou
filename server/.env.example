# BetterYou AI Proxy Server Environment Configuration
PORT=8787
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Shared bootstrap secret for device registration (protects /v1/devices/register)
# If left empty, bootstrap check is disabled (recommended for local development)
BOOTSTRAP_SECRET=

# Optional: Upstash Redis for distributed multi-instance rate limiting and device store
# If left empty, proxy automatically falls back to in-memory store
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Rate limit configuration
RATE_LIMIT_MINUTE=15
RATE_LIMIT_DAILY=150

# Optional: Platform Attestation (Google Play Integrity / Apple App Attest)
# Default is false (no-op dev verifier)
ENABLE_PLATFORM_ATTESTATION=false
