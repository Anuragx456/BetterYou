# =============================================================
# BetterYou Environment Configuration
# =============================================================

# Mobile Client Proxy URL
# Points to your local or deployed BetterYou Hono proxy server.
# Default for local development: http://localhost:8787 (or http://<your-lan-ip>:8787 on physical device)
EXPO_PUBLIC_PROXY_URL=http://localhost:8787

# Server Configuration (for /server)
# Master Gemini API Key (held on the server proxy, NEVER inlined into the client app bundle)
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8787
